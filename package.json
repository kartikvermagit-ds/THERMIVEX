{
  "name": "thermivex",
  "version": "1.0.0",
  "description": "AI-Based Detection and Classification of Industrial Fires and Persistent Thermal Sources",
  "private": true,
  "scripts": {
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
